#!/usr/bin/env bash
# Test-Ersatz für die AWS-CLI: bildet nur die von backup.sh/restore.sh genutzten Befehle auf ein
# lokales Verzeichnis ($STUB_S3_DIR/<bucket>/<key>) ab. Prüft NICHT das echte S3-Protokoll.
set -euo pipefail
args=("$@"); i=0
[[ "${args[0]}" == "--endpoint-url" ]] && args=("${args[@]:2}")
root="${STUB_S3_DIR:?}"
svc="${args[0]}"; cmd="${args[1]}"; rest=("${args[@]:2}")
opt() { local n="$1"; shift; while (($#)); do [[ "$1" == "$n" ]] && { echo "$2"; return; }; shift; done; }
if [[ -n "${STUB_FAIL:-}" && "$cmd" == "$STUB_FAIL" ]]; then echo "stub: erzwungener Fehler bei $cmd" >&2; exit 1; fi
case "$svc $cmd" in
  "s3 cp")
    src="${rest[0]}"; dst="${rest[1]}"
    p() { local x="$1"; [[ "$x" == s3://* ]] && echo "$root/${x#s3://}" || echo "$x"; }
    s="$(p "$src")"; d="$(p "$dst")"; mkdir -p "$(dirname "$d")"; cp "$s" "$d" ;;
  "s3api head-object")
    f="$root/$(opt --bucket "${rest[@]}")/$(opt --key "${rest[@]}")"
    [[ -f "$f" ]] || { echo "stub: nicht gefunden" >&2; exit 254; }
    if [[ -n "${STUB_WRONG_SIZE:-}" ]]; then echo 1; else wc -c < "$f" | tr -d ' '; fi ;;
  "s3api list-objects-v2")
    b="$(opt --bucket "${rest[@]}")"; pre="$(opt --prefix "${rest[@]}")"
    [[ -d "$root/$b" ]] || { echo None; exit 0; }
    out="$(cd "$root/$b" && find . -type f | sed 's|^\./||' | grep -F "$pre" | grep "^$pre" | sort | paste -sd'\t' - || true)"
    [[ -n "$out" ]] && echo "$out" || echo None ;;
  "s3api delete-object")
    rm -f "$root/$(opt --bucket "${rest[@]}")/$(opt --key "${rest[@]}")" ;;
  *) echo "stub: Befehl nicht unterstützt: $svc $cmd" >&2; exit 2 ;;
esac
