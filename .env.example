# Lokale Entwicklung: als .env kopieren und ausfüllen. .env niemals committen.
# Auf Railway werden die Werte als Service-Variablen gesetzt, nicht über diese Datei.

# PostgreSQL-Verbindung (Railway: Referenz auf ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://user:password@localhost:5432/yacht_emissions
# Nur lokal ohne SSL; auf Railway NICHT setzen
# DATABASE_SSL=false

# Port (Railway setzt PORT selbst)
PORT=3000

# aisstream.io – derzeit ungenutzt (connectAIS() deaktiviert)
# AISSTREAM_API_KEY=

# Admin-Seite (/admin/) und Admin-API: ohne Token gesperrt. Lang und zufällig wählen (≥ 32 Zeichen).
# ADMIN_TOKEN=

# Optional: Rate-Limit der öffentlichen API je IP und Minute (Standard 240)
# API_RATE_PER_MIN=240

# Optional: Kappung der Zeitintegration in Stunden (Standard 7)
# MAX_GAP_HOURS=7
# Optional: Schwefelgehalt Kraftstoff
# FUEL_SULPHUR=
